# Supabase 프로젝트 설정에서 확인한 값을 backend/.env에 입력하세요. 이 파일(.env.example)에는 실제 값을 쓰지 마세요.
# 환경 변수가 있으면 .env보다 우선합니다. 값을 바꾼 뒤에는 서버를 다시 시작하세요.

# --- 공개해도 되는 값: GET /api/config로 브라우저에 전달됩니다 ---
# Session pooler/DB 접속 문자열이 아니라 HTTPS API URL을 사용합니다.
# Project URL 예: https://<프로젝트 ID>.supabase.co
SUPABASE_URL=
# Publishable key(sb_publishable_... 로 시작). 브라우저에 공개해도 되는 키입니다. 서버 전용 키를 넣지 마세요(형식이 다르면 인증이 꺼집니다).
SUPABASE_PUBLISHABLE_KEY=
# 이 앱을 여는 주소(경로 없이). 인증 콜백 주소의 기준이며 127.0.0.1과 localhost는 다른 주소입니다. 한쪽만 쓰세요.
APP_ORIGIN=http://127.0.0.1:8000

# --- 서버 전용 비밀 값: 절대 공개하지 않습니다 ---
# Secret key(sb_secret_... 로 시작). RLS를 우회하는 관리용 키이며 일반 사용자 요청에는 쓰지 않습니다. HTML 또는 JavaScript 파일에 넣지 마세요. 필요 없으면 비워 두세요.
SUPABASE_SECRET_KEY=

# --- 선택 ---
# 다른 환경 파일을 쓰거나(경로), .env를 읽지 않으려면(빈 값) 지정합니다. 테스트가 .env를 읽지 않도록 이 값을 비웁니다.
# APP_ENV_FILE=
